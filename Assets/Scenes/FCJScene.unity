  m_Script: {fileID: 11500000, guid: 65e6b3f8ae5aec8429f5f2bccd6e3dd8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueTrigger
  saveId: 
  dialogueController: {fileID: 1975308692}
  conversations:
  - conversationName: "\u7B2C\u4E00\u6B21\u5BF9\u8BDD"
    dialogueLines:
    - speakerName: npc
      dialogueText: "\u6D4B\u8BD5\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A"
    - speakerName: npc
      dialogueText: "\u597D\u597D\u597D"
    - speakerName: npc
      dialogueText: "\u6700\u540E1"
  - conversationName: "\u7B2C\u4E8C\u6B21\u5BF9\u8BDD"
    dialogueLines:
    - speakerName: npc
      dialogueText: "\u6211\u53BB"
    - speakerName: npc
      dialogueText: "\u4F60\u600E\u4E48\u8FD8\u6765"
    - speakerName: npc
      dialogueText: "\u6700\u540E2"
  - conversationName: "\u7B2C\u4E09\u6B21\u5BF9\u8BDD"
    dialogueLines:
    - speakerName: npc
      dialogueText: "\u3002\u3002\u3002"
    - speakerName: npc
      dialogueText: "\u518D\u65E0\u8BDD\u8BF4"
  dialogueLines:
  - speakerName: "\u73A9\u5BB6"
    dialogueText: "\u6D4B\u8BD5\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A"
  - speakerName: "\u73A9\u5BB6"
    dialogueText: "\u54C7\u585E\u5443\u5443\u5443\u5443\u5443\u5443\u5443\u5443\u5443\u5443"
  - speakerName: "\u73A9\u5BB6"
    dialogueText: "\u53EF\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7\u54C7"
  - speakerName: "\u73A9\u5BB6"
    dialogueText: "\u5165\u53E3\u5904\u9644\u8FD1\u7684\u89D2\u843D\u653E\u7740\u4E00\u4E9B\u8FD0\u52A8\u7528\u54C1\uFF0C\u6709\u547C\u5566\u5708\u3001\u513F\u7AE5\u6C99\u5305\u3001\u8DF3\u7EF3\u3001\u4E94\u989C\u516D\u8272\u7684\u5851\u6599\u7403\u7B49\uFF0C\u4F3C\u4E4E\u539F\u672C\u662F\u51C6\u5907\u5728\u4ECA\u5929\u7684\u8FD0\u52A8\u4F1A\u4E0A\u4F7F\u7528\u7684\u3002\u5F80\u804C\u5458\u5BA4\u8D70\u53BB\u7684\u8D70\u5ECA\u5899\u4E0A\u6709\u4E00\u4E2A\u5E03\u544A\u680F\uFF0C\u8D34\u7740\u5B69\u5B50\u4EEC\u7684\u4F5C\u54C1\u3001\u4E00\u4E9B\u65E5\u5E38\u901A\u77E5\u548C\u5E0C\u671B\u5B64\u513F\u9662\u7684\u804C\u5458\u7ED3\u6784\u56FE\u3002"
  - speakerName: "\u73A9\u5BB6"
    dialogueText: "\u804C\u5458\u5BA4\u662F\u4E00\u95F4\u5C0F\u578B\u7684\u529E\u516C\u5BA4\u3002\u9664\u4E86\u9662\u957F\uFF0C\u6BCF\u4E00\u4F4D\u804C\u5458\u90FD\u6709\u5C5E\u4E8E\u81EA\u5DF1\u7684\u529E\u516C\u7A7A\u95F4\uFF0C\u5404\u81EA\u7684\u684C\u4E0A\u4E5F\u90FD\u7C98\u7740\u8BE5\u804C\u5458\u7684\u540D\u5B57\u3002\u5F20\u6167\u73B2\u7684\u684C\u4E0A\u653E\u7740\u5173\u4E8E\u8FD9\u6B21\u8FD0\u52A8\u4F1A\u7684\u6D41\u7A0B\u8868\u3002\u738B\u79C0\u4E3D\u7684\u684C\u4E0A\u653E\u7740\u6279\u6539\u5230\u4E00\u534A\u7684\u5B69\u5B50\u4EEC\u7684\u4F5C\u4E1A\u3002\u674E\u79C0\u82B3\u7684\u7535\u8111\u8367\u5E55\u8FB9\u7F18\u7C98\u7740\u4E00\u5F20\u63D0\u9192\u81EA\u5DF1\u5BC6\u7801\u7684\u5C0F\u7EB8\u6761\u3002"
  - speakerName: "\u73A9\u5BB6"
    dialogueText: "\u505A\u5B8C\u7EC3\u4E60\u9898\u540E\uFF0C\u65F6\u5019\u4E5F\u4E0D\u65E9\u4E86\u3002\u5728\u7B80\u5355\u7684\u5403\u8FC7\u665A\u9910\u3001\u68B3\u6D17\u8FC7\u540E\uFF0C\u6211\u8EBA\u5230\u4E86\u5E8A\u4E0A\uFF0C\u8FDB\u5165\u68A6\u4E61\u3002"
  allowRepeatConversation: 1
  hasTalked: 0
  nextConversationIndex: 0

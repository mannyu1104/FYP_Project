  m_Name: "NAD_\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\uFF0C\u9662\u957F\u4E0B\u843D\u4E0D\u660E\uFF01"
  m_EditorClassIdentifier: Assembly-CSharp::NewsArticleData
  headline: "\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\uFF0C\u9662\u957F\u4E0B\u843D\u4E0D\u660E\uFF01"
  date: "2012\u5E748\u67081\u65E5"
  content: "\u4ECA\u65E5\uFF088\u67081\u65E5\uFF09\u63A5\u8FD1\u6E05\u6668\u65F6\u5206\uFF0C\u4F4D\u4E8E\u90CA\u5916\u7684\u5E0C\u671B\u5B64\u513F\u9662\u7A81\u53D1\u706B\u707E\u3002\u6240\u5E78\u4E8B\u53D1\u5F53\u65F6\u4EE5\u6709\u51E0\u540D\u5B64\u513F\u9662\u91CC\u7684\u804C\u5458\u8D77\u8EAB\uFF0C\u4ED6\u4EEC\u7B2C\u4E00\u65F6\u95F4\u53D1\u73B0\u4E8B\u6545\u5411\u6D88\u9632\u5C40\u62A5\u4E86\u6848\uFF0C\u5E76\u5408\u7406\u758F\u6563\u5728\u5B64\u513F\u9662\u91CC\u7684\u5B64\u513F\u4EEC\u3002\u6D88\u9632\u5458\u4E5F\u968F\u540E\u8D76\u5230\u5C06\u706B\u707E\u8303\u56F4\u9650\u5236\u5E76\u6251\u706D\u7531\u4E8E\u804C\u5458\u4EEC\u8FC5\u901F\u7684\u5224\u65AD\uFF0C\u672C\u8D77\u706B\u707E\u5E76\u65E0\u9020\u6210\u4EFB\u4F55\u4EBA\u5458\u7684\u4F24\u4EA1\u3002\n\n\n\n\u6B63\u5F53\u4E00\u5207\u770B\u4F3C\u6709\u60CA\u65E0\u9669\u7684\u7ED3\u675F\u65F6\uFF0C\u5374\u4F20\u51FA\u4E86\u5B64\u513F\u9662\u9662\u957F\uFF08\u9648\u5FD7\u5B8F\uFF09\u5931\u8E2A\u7684\u6D88\u606F\u3002\u636E\u51E0\u4F4D\u804C\u5458\u6240\u8BF4\uFF0C\u4ED6\u4EEC\u5728\u5C31\u5BDD\u4E4B\u524D\u8FD8\u6709\u89C1\u8FC7\u9662\u957F\uFF0C\u4F46\u5728\u706B\u707E\u53D1\u751F\u540E\u7684\u73B0\u5728\u5374\u4E0D\u89C1\u4ED6\u4EBA\uFF0C\u4E5F\u65E0\u6CD5\u4E0E\u4ED6\u53D6\u5F97\u8054\u7EDC\u3002\u6D88\u9632\u4EBA\u58EB\u4E5F\u6CA1\u6709\u5728\u706B\u707E\u73B0\u573A\u627E\u5230\u7591\u4F3C\u9662\u957F\u7684\u4EBA\u5F71\u3002\u6B64\u60C5\u51B5\u5DF2\u4E0A\u62A5\u8B66\u65B9\uFF0C\u5E76\u88AB\u5224\u65AD\u4E3A\u5931\u8E2A\u3002\n\n\n\n\n\n\n\n\u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u5E78\u597D\u53CA\u65F6\u53D1\u73B0\u2026\u2026\u300D\n\n\u7559\u8A002\uFF1A\u300C\u6CA1\u8BF4\u4EC0\u4E48\u539F\u56E0\u53D1\u751F\u7684\u706B\u707E\u5417\uFF1F\u300D\n\n\u7559\u8A003\uFF1A\u300C\u9662\u957F\u5377\u6B3E\u8DD1\u8DEF\u4E86\u5427\u300D\n\n\u7559\u8A004\uFF1A\u300C\u771F\u7684\u5047\u7684\uFF1F\uFF01\u90A3\u8FD9\u706B\u4E0D\u4F1A\u4E5F\u662F\u9662\u957F\u653E\u7684\u5427\u300D\n\n\u7559\u8A005\uFF1A\u300C\u90A3\u8FD9\u7FA4\u5B64\u513F\u4E4B\u540E\u4F4F\u54EA\u554A\uFF1F\u300D\n\n\u7559\u8A006\uFF1A\u300C\u4E00\u4E2A\u5C0F\u5C0F\u7684\u5B64\u513F\u9662\u5374\u80FD\u591F\u7ECF\u8425\u8FD9\u4E48\u4E45\uFF0C\u516B\u6210\u662F\u6709\u5728\u80CC\u540E\u5E72\u4E9B\u4E0D\u5E72\u51C0\u7684\u52FE\u5F53\u5427\u3002\u300D"

  m_EditorClassIdentifier: Assembly-CSharp::OrphanageAnnouncementData
  clueTitle: "\u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u6301\u7EED\u8425\u8FD0\u8BF4\u660E"
  clueSummary: 
  isCredible: 1
  title: "\u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u6301\u7EED\u8425\u8FD0\u8BF4\u660E"
  date: "2009\u5E745\u67082\u65E5"
  content: "\u611F\u8C22\u5404\u4F4D\u4E8E\u65E5\u524D\u7ED9\u4E88\u5E0C\u671B\u5B64\u513F\u9662\u7684\u5173\u5FC3\u4E0E\u9F13\u52B1\u3002\n\n\n\u672C\u9662\u5F88\u9AD8\u5174\u5411\u5927\u5BB6\u5BA3\u5E03\uFF0C\u5728\u5404\u754C\u7684\u5173\u5FC3\u4E0E\u652F\u6301\u4E0B\uFF0C\u672C\u9662\u76EE\u524D\u7684\u8425\u8FD0\u95EE\u9898\u4EE5\u83B7\u5F97\u6539\u5584\u5E76\u5C06\u7EE7\u7EED\u8425\u8FD0\uFF0C\u539F\u5148\u9884\u8BA1\u7684\u505C\u8FD0\u5B89\u6392\u4E5F\u5C06\u53D6\u6D88\u3002\n\n\n\u672A\u6765\uFF0C\u672C\u9662\u5C06\u6301\u7EED\u81F4\u529B\u4E8E\u63D0\u4F9B\u5B69\u5B50\u4EEC\u5B89\u5168\u3001\u7A33\u5B9A\u4E14\u6E29\u6696\u7684\u6210\u957F\u73AF\u5883\uFF0C\u5E76\u59A5\u5584\u8FD0\u7528\u6BCF\u4E00\u4EFD\u5584\u5FC3\u8D44\u6E90\uFF0C\u4E3A\u5B69\u5B50\u4EEC\u521B\u9020\u66F4\u597D\u7684\u5B66\u4E60\u4E0E\u751F\u6D3B\u6761\u4EF6\u3002\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662
    \u656C\u542F"

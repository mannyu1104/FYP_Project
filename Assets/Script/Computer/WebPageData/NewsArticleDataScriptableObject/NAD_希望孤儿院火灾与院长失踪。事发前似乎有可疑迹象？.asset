  m_Name: "NAD_\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\u4E0E\u9662\u957F\u5931\u8E2A\u3002\u4E8B\u53D1\u524D\u4F3C\u4E4E\u6709\u53EF\u7591\u8FF9\u8C61\uFF1F"
  m_EditorClassIdentifier: Assembly-CSharp::NewsArticleData
  clueTitle: "\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\u4E0E\u9662\u957F\u5931\u8E2A\u3002\u4E8B\u53D1\u524D\u4F3C\u4E4E\u6709\u53EF\u7591\u8FF9\u8C61\uFF1F"
  clueSummary: "- \u4ECA\u65E5\u51CC\u6668\u5E0C\u671B\u5B64\u513F\u9662\u53D1\u751F\u706B\u707E\u4F46\u6CA1\u6709\u4F24\u4EA1\n-
    \u706B\u707E\u539F\u56E0\u4E0D\u592A\u53EF\u80FD\u662F\u610F\u5916\n- \u9662\u957F\u6700\u8FD1\u90FD\u65E9\u51FA\u665A\u5F52\n-
    \u6709\u4EBA\u76EE\u51FB\u4E00\u8F86\u9ED1\u8272\u8F7F\u8F66\u505C\u5728\u5B64\u513F\u9662\u9644\u8FD1"
  headline: "\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\u4E0E\u9662\u957F\u5931\u8E2A\u3002\u4E8B\u53D1\u524D\u4F3C\u4E4E\u6709\u53EF\u7591\u8FF9\u8C61\uFF1F"
  date: "2012\u5E748\u67081\u65E5"
  content: "\u5E0C\u671B\u5B64\u513F\u9662\u4ECA\u65E5\u51CC\u6668\u53D1\u751F\u706B\u707E\uFF0C\u6D88\u9632\u5C40\u63A5\u83B7\u62A5\u6848\u540E\u8FC5\u901F\u8D76\u5F80\u73B0\u573A\uFF0C\u6210\u529F\u63A7\u5236\u706B\u52BF\uFF0C\u6240\u5E78\u9662\u5185\u513F\u7AE5\u53CA\u804C\u5458\u5747\u5DF2\u53CA\u65F6\u758F\u6563\uFF0C\u5E76\u672A\u9020\u6210\u4EBA\u5458\u4F24\u4EA1\u3002\u672C\u62A5\u8BB0\u8005\u7B2C\u4E00\u65F6\u95F4\u8D70\u8BBF\u9644\u8FD1\u5C45\u6C11\u5E76\u5F97\u5230\u4E86\u4E00\u4E0B\u51E0\u70B9\u8BF4\u6CD5\u3002\n\n\n\n\u6709\u5C45\u6C11\u8868\u793A\uFF0C\u5B64\u513F\u9662\u7684\u8BBE\u5907\u4F3C\u4E4E\u4E00\u76F4\u90FD\u6709\u5728\u68C0\u70B9\u7FFB\u65B0\uFF0C\u5E94\u8BE5\u4E0D\u592A\u53EF\u80FD\u53D1\u751F\u610F\u5916\u3002\u4E5F\u6709\u5C45\u6C11\u8868\u793A\uFF0C\u8FD9\u4E00\u4E2A\u6708\u6765\u9648\u5FD7\u5B8F\u9662\u957F\u4F3C\u4E4E\u6BCF\u5929\u90FD\u65E9\u51FA\u665A\u5F52\uFF0C\u4E0D\u592A\u50CF\u4ED6\u4EE5\u524D\u7684\u4F5C\u98CE\u3002\u53E6\u4E00\u4F4D\u5C45\u6C11\u5219\u8868\u793A\uFF0C\u5F53\u665A\u66FE\u770B\u5230\u4E00\u8F86\u9ED1\u8272\u8F7F\u8F66\u505C\u9760\u5728\u5B64\u513F\u9662\u9644\u8FD1\u3002\n\n\n\n\u8BC4\u8BBA\u533A\n\n\u8BC4\u8BBA\u533A\u5DF2\u5173\u95ED"

  m_EditorClassIdentifier: Assembly-CSharp::OrphanageAnnouncementData
  clueTitle: "\u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u505C\u8FD0\u8BF4\u660E"
  clueSummary: 
  isCredible: 1
  title: "\u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u505C\u8FD0\u8BF4\u660E"
  date: "2009\u5E744\u670818\u65E5"
  content: "\u611F\u8C22\u5404\u4F4D\u957F\u671F\u4EE5\u6765\u5BF9\u5E0C\u671B\u5B64\u513F\u9662\u7684\u5173\u5FC3\u4E0E\u652F\u6301\u3002\n\n\n\u7531\u4E8E\u8FD1\u5E74\u6765\u8425\u8FD0\u7ECF\u8D39\u6301\u7EED\u77ED\u7F3A\uFF0C\u52A0\u4E0A\u9662\u820D\u7EF4\u62A4\u53CA\u513F\u7AE5\u7167\u62A4\u652F\u51FA\u4E0D\u65AD\u589E\u52A0\uFF0C\u672C\u9662\u76EE\u524D\u5DF2\u9762\u4E34\u4E25\u91CD\u7684\u8D22\u653F\u56F0\u96BE\u3002\u7ECF\u591A\u65B9\u8BC4\u4F30\u540E\uFF0C\u5E0C\u671B\u5B64\u513F\u9662\u9884\u8BA1\u5C06\u4E8E\u8FD1\u671F\u505C\u6B62\u8425\u8FD0\u3002\n\n\n\u76EE\u524D\uFF0C\u672C\u9662\u6B63\u79EF\u6781\u4E0E\u76F8\u5173\u653F\u5E9C\u5355\u4F4D\u53CA\u513F\u7AE5\u798F\u5229\u673A\u6784\u8054\u7CFB\uFF0C\u59A5\u5584\u5B89\u6392\u9662\u5185\u5B69\u5B50\u4EEC\u540E\u7EED\u7684\u751F\u6D3B\u4E0E\u5B89\u7F6E\u4E8B\u5B9C\uFF0C\u5E0C\u671B\u5C3D\u53EF\u80FD\u964D\u4F4E\u6B64\u6B21\u4E8B\u4EF6\u5BF9\u5B69\u5B50\u4EEC\u9020\u6210\u7684\u5F71\u54CD\u3002\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662
    \u656C\u542F"

  m_Name: "NAD_BB-04\uFF0C\u6253\u7834\u533B\u5B66\u754C\u96BE\u9898\uFF0C\u6839\u6CBB\u7EDD\u75C7\uFF01"
  m_EditorClassIdentifier: Assembly-CSharp::NewsArticleData
  clueTitle: "BB-04\uFF0C\u6253\u7834\u533B\u5B66\u754C\u96BE\u9898\uFF0C\u6839\u6CBB\u7EDD\u75C7\uFF01"
  clueSummary: "\u4ED4\u7EC6\u5BF9\u6BD4\u540E\u5C31\u4F1A\u53D1\u73B0\u5728\u53F0\u4E0A\u6F14\u8BB2\u7684\u8D1F\u8D23\u4EBA\u5C31\u662F\u5E0C\u671B\u5B64\u513F\u9662\u7684\u5176\u4E2D\u4E00\u4F4D\u804C\u5458\u5218\u5FD7\u660E"
  clueCredibility: 0
  caseDefinition: {fileID: 0}
  headline: "BB-04\uFF0C\u6253\u7834\u533B\u5B66\u754C\u96BE\u9898\uFF0C\u6839\u6CBB\u7EDD\u75C7\uFF01"
  date: "2012\u5E746\u670829\u65E5"
  content: "\u84DD\u8776\u5236\u836F\u516C\u53F8\u4E8E\u4ECA\u65E5\u53D1\u5E03\u4E86\u4ED6\u4EEC\u6700\u65B0\u7684\u7814\u53D1\u6210\u679C\u201CBB-04\u201D\u3002\u8BE5\u836F\u7269\u5C06\u6709\u671B\u6839\u6CBB\u56F0\u6270\u4E86\u533B\u5B66\u754C\u7684\u8BB8\u4E45\u7684\u764C\u75C7\u3001\u827E\u6ECB\u75C5\u7B49\u7EDD\u75C7\u3002\n\n\n\u636E\u8BE5\u9879\u76EE\u8D1F\u8D23\u4EBA\u6240\u8BF4\uFF0C\u8BE5\u836F\u7269\u76EE\u524D\u8FD8\u5904\u4E8E\u5B9E\u9A8C\u9636\u6BB5\uFF0C\u4F46\u76F8\u4FE1\u5728\u4E0D\u4E45\u7684\u5C06\u6765BB-04\u5C06\u6B63\u5F0F\u6210\u4E3A\u533B\u5B66\u754C\u7684\u5947\u8FF9\u3002\n\n\n\u3010\u9644\u4E0A\u9879\u76EE\u8D1F\u8D23\u4EBA\u4E8E\u53D1\u8868\u4F1A\u6F14\u8BB2\u65F6\u7684\u7167\u7247\u3011\n\n"
  comments: []

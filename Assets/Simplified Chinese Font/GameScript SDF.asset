    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 8
    characterSequence: "# \u5165\u53E3\u5904\n\n\n\n\u5165\u53E3\u5904\u9644\u8FD1\u7684\u89D2\u843D\u653E\u7740\u4E00\u4E9B\u8FD0\u52A8\u7528\u54C1\uFF0C\u6709\u547C\u5566\u5708\u3001\u513F\u7AE5\u6C99\u5305\u3001\u8DF3\u7EF3\u3001\u4E94\u989C\u516D\u8272\u7684\u5851\u6599\u7403\u7B49\uFF0C\u4F3C\u4E4E\u539F\u672C\u662F\u51C6\u5907\u5728\u4ECA\u5929\u7684\u8FD0\u52A8\u4F1A\u4E0A\u4F7F\u7528\u7684\u3002\u5F80\u804C\u5458\u5BA4\u8D70\u53BB\u7684\u8D70\u5ECA\u5899\u4E0A\u6709\u4E00\u4E2A\u5E03\u544A\u680F\uFF0C\u8D34\u7740\u5B69\u5B50\u4EEC\u7684\u4F5C\u54C1\u3001\u4E00\u4E9B\u65E5\u5E38\u901A\u77E5\u548C\u5E0C\u671B\u5B64\u513F\u9662\u7684\u804C\u5458\u7ED3\u6784\u56FE\u3002\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u804C\u5458\u5BA4\n\n\n\n\u804C\u5458\u5BA4\u662F\u4E00\u95F4\u5C0F\u578B\u7684\u529E\u516C\u5BA4\u3002\u9664\u4E86\u9662\u957F\uFF0C\u6BCF\u4E00\u4F4D\u804C\u5458\u90FD\u6709\u5C5E\u4E8E\u81EA\u5DF1\u7684\u529E\u516C\u7A7A\u95F4\uFF0C\u5404\u81EA\u7684\u684C\u4E0A\u4E5F\u90FD\u7C98\u7740\u8BE5\u804C\u5458\u7684\u540D\u5B57\u3002\u5F20\u6167\u73B2\u7684\u684C\u4E0A\u653E\u7740\u5173\u4E8E\u8FD9\u6B21\u8FD0\u52A8\u4F1A\u7684\u6D41\u7A0B\u8868\u3002\u738B\u79C0\u4E3D\u7684\u684C\u4E0A\u653E\u7740\u6279\u6539\u5230\u4E00\u534A\u7684\u5B69\u5B50\u4EEC\u7684\u4F5C\u4E1A\u3002\u674E\u79C0\u82B3\u7684\u7535\u8111\u8367\u5E55\u8FB9\u7F18\u7C98\u7740\u4E00\u5F20\u63D0\u9192\u81EA\u5DF1\u5BC6\u7801\u7684\u5C0F\u7EB8\u6761\u3002\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u5BFC\u5165\n\n\n\n-7\u670831\u65E5-\n\n\n\n\u5728\u89E3\u51B3\u4E86\u4E00\u4E2A\u7B80\u5355\u7684\u6848\u4EF6\u56DE\u5230\u5BB6\u540E\uFF0C\u6211\u770B\u4E86\u773C\u624B\u673A\u4E0A\u663E\u793A\u7684\u65E5\u671F\uFF0C\u53C8\u770B\u4E86\u770B\u4FA6\u63A2\u6267\u7167\u4E0A\u7684\u6709\u6548\u65E5\u671F\u2026\u2026\u53EA\u5269\u4E00\u4E2A\u6708\u4E86\uFF0C\u662F\u65F6\u5019\u8981\u518D\u8003\u4E00\u6B21\u4FA6\u63A2\u8D44\u683C\u6D4B\u8BD5\u66F4\u65B0\u4E00\u4E0B\u671F\u9650\u4E86\u3002\n\n\n\n\u867D\u7136\u53EA\u662F\u91CD\u8003\u4E00\u6B21\u8D44\u683C\u6D4B\u8BD5\uFF0C\u60F3\u5408\u683C\u8FD8\u662F\u5F88\u6709\u4FE1\u5FC3\u7684\uFF0C\u4F46\u4EE5\u9632\u4E07\u4E00\u8FD8\u662F\u53BB\u505A\u4E2A\u7EC3\u4E60\u9898\u5427\uFF0C\u6BD5\u7ADF\u6D4B\u8BD5\u7684\u9898\u76EE\u4E0E\u73B0\u5B9E\u7684\u6848\u4EF6\u8FD8\u662F\u6709\u70B9\u5DEE\u522B\u7684\u3002\n\n\n\n\u6211\u5728\u7535\u8111\u684C\u524D\u5750\u4E0B\uFF0C\u6253\u5F00\u4FA6\u63A2\u534F\u4F1A\u7684\u7F51\u7AD9\u5E76\u8BBF\u95EE\u4E86\u4ED6\u4EEC\u516C\u5F00\u7684\u6D4B\u8BD5\u7EC3\u4E60\u9898\u2026\u2026\n\n\n\n\uFF08\u627E\u732B\u6848\u4EF6\uFF09\n\n\n\n\u505A\u5B8C\u7EC3\u4E60\u9898\u540E\uFF0C\u65F6\u5019\u4E5F\u4E0D\u65E9\u4E86\u3002\u5728\u7B80\u5355\u7684\u5403\u8FC7\u665A\u9910\u3001\u68B3\u6D17\u8FC7\u540E\uFF0C\u6211\u8EBA\u5230\u4E86\u5E8A\u4E0A\uFF0C\u8FDB\u5165\u68A6\u4E61\u3002\n\n\n\n-8\u67081\u65E5-\n\n\n\n\u7741\u5F00\u773C\u775B\u53C8\u662F\u65B0\u7684\u4E00\u5929\uFF0C\u4E0D\u77E5\u9053\u4ECA\u5929\u80FD\u4E0D\u80FD\u63A5\u5230\u4EC0\u4E48\u597D\u8D5A\u7684\u59D4\u6258\u5462\u3002\u5982\u679C\u6CA1\u6709\uFF0C\u6709\u8DA3\u7684\u884C\u554A\u3002\u60F3\u7740\u8FD9\u4E9B\u6709\u7684\u6CA1\u7684\uFF0C\u6211\u4F8B\u884C\u7684\u6253\u5F00\u65B0\u95FB\u7F51\u7AD9\u770B\u770B\u4ECA\u5929\u6709\u4EC0\u4E48\u65B0\u95FB\u3002\u6301\u7EED\u63A5\u53D7\u6700\u65B0\u8D44\u8BAF\u53EF\u662F\u8EAB\u4E3A\u4E00\u540D\u4FA6\u63A2\u7684\u57FA\u672C\u3002\n\n\n\n--
      \u9605\u8BFB\u300A\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\uFF0C\u9662\u957F\u4E0B\u843D\u4E0D\u660E\uFF01\u300B--\n\n\n\n\u6CA1\u60F3\u5230\u5728\u6211\u7761\u89C9\u7684\u65F6\u5019\u53D1\u751F\u4E86\u8FD9\u4E48\u4E00\u4EF6\u4E8B\uFF0C\u800C\u4E14\u4ECE\u5185\u5BB9\u4E0E\u5E95\u4E0B\u7684\u7559\u8A00\u6765\u770B\u4F3C\u4E4E\u8FD8\u4E0D\u53EA\u662F\u4E00\u4E2A\u5355\u7EAF\u7684\u706B\u707E\u4E8B\u6545\u3002\u6B63\u5F53\u6211\u60F3\u518D\u770B\u770B\u6709\u6CA1\u6709\u5176\u4ED6\u8D44\u8BAF\u65F6\uFF0C\u95E8\u94C3\u54CD\u4E86\u3002\n\n\n\n\u79BB\u5F00\u7535\u8111\u53BB\u5E94\u95E8\uFF0C\u6253\u5F00\u95E8\u770B\u5230\u7684\u662F\u4E00\u4F4D\u4E2D\u5E74\u5973\u6027\u3002\u4ED6\u5728\u770B\u5230\u6211\u7684\u4E00\u77AC\u95F4\u5C31\u5F00\u53E3\u5BF9\u6211\u8BF4\u5230\u3002\n\n\n\n\u300C\u4F60\u5C31\u662F\u90A3\u4E2A\u6709\u540D\u7684\u4FA6\u63A2\u5417\uFF0C\u8BF7\u63A5\u4E0B\u6211\u7684\u59D4\u6258\uFF01\u300D\n\n\u300C\u8BF7\u95EE\u4F60\u770B\u4E86\u4ECA\u65E9\u5B64\u513F\u9662\u7684\u65B0\u95FB\u4E86\u5417\uFF0C\u6211\u662F\u5728\u91CC\u9762\u5DE5\u4F5C\u4E86\u5F88\u4E45\u7684\u4E00\u4F4D\u804C\u5458\u3002\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\u6211\u4EEC\u9662\u957F\u4F3C\u4E4E\u88AB\u51A0\u4E0A\u4E86\u65E0\u4E2D\u751F\u6709\u7684\u6C61\u540D\u3002\u6211\u8DDF\u4E86\u4ED6\u90A3\u4E48\u65E7\uFF0C\u6211\u4E0D\u8BA4\u4E3A\u4ED6\u662F\u4F1A\u505A\u51FA\u90A3\u79CD\u4E8B\u7684\u4EBA\u3002\u300D\n\n\u300C\u867D\u7136\u4ED6\u8FD9\u4E2A\u65F6\u95F4\u70B9\u5931\u8E2A\u786E\u5B9E\u5F88\u53EF\u7591\uFF0C\u6240\u4EE5\u6211\u5E0C\u671B\u4F60\u80FD\u8C03\u67E5\u8FD9\u4EF6\u4E8B\u60C5\uFF0C\u6765\u8BC1\u660E\u9662\u957F\u662F\u4E0D\u662F\u6E05\u767D\u7684\u3002\u300D\n\n\n\n\u542C\u5B8C\u4ED6\u7684\u8BDD\uFF0C\u6211\u51B3\u5B9A\u63A5\u4E0B\u8FD9\u4E2A\u59D4\u6258\uFF0C\u5C06\u85CF\u5728\u6697\u9762\u7684\u771F\u76F8\u8C03\u67E5\u6E05\u695A\u3002\n\n\n\n\n\n---\n\nOvO\n\n---\n\n##
      \u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u6301\u7EED\u8425\u8FD0\u8BF4\u660E\n\n\u53D1\u5E03\u65E5\u671F\uFF1A2009\u5E745\u67082\u65E5\n\n\n\n\u611F\u8C22\u5404\u4F4D\u4E8E\u65E5\u524D\u7ED9\u4E88\u5E0C\u671B\u5B64\u513F\u9662\u7684\u5173\u5FC3\u4E0E\u9F13\u52B1\u3002\n\n\n\n\u672C\u9662\u5F88\u9AD8\u5174\u5411\u5927\u5BB6\u5BA3\u5E03\uFF0C\u5728\u5404\u754C\u7684\u5173\u5FC3\u4E0E\u652F\u6301\u4E0B\uFF0C\u672C\u9662\u76EE\u524D\u7684\u8425\u8FD0\u95EE\u9898\u4EE5\u83B7\u5F97\u6539\u5584\u5E76\u5C06\u7EE7\u7EED\u8425\u8FD0\uFF0C\u539F\u5148\u9884\u8BA1\u7684\u505C\u8FD0\u5B89\u6392\u4E5F\u5C06\u53D6\u6D88\u3002\n\n\n\n\u672A\u6765\uFF0C\u672C\u9662\u5C06\u6301\u7EED\u81F4\u529B\u4E8E\u63D0\u4F9B\u5B69\u5B50\u4EEC\u5B89\u5168\u3001\u7A33\u5B9A\u4E14\u6E29\u6696\u7684\u6210\u957F\u73AF\u5883\uFF0C\u5E76\u59A5\u5584\u8FD0\u7528\u6BCF\u4E00\u4EFD\u5584\u5FC3\u8D44\u6E90\uFF0C\u4E3A\u5B69\u5B50\u4EEC\u521B\u9020\u66F4\u597D\u7684\u5B66\u4E60\u4E0E\u751F\u6D3B\u6761\u4EF6\u3002\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662
      \u656C\u542F\n\n---\n\n## \u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u505C\u8FD0\u8BF4\u660E\n\n\u53D1\u5E03\u65E5\u671F\uFF1A2009\u5E744\u670818\u65E5\n\n\n\n\u611F\u8C22\u5404\u4F4D\u957F\u671F\u4EE5\u6765\u5BF9\u5E0C\u671B\u5B64\u513F\u9662\u7684\u5173\u5FC3\u4E0E\u652F\u6301\u3002\n\n\n\n\u7531\u4E8E\u8FD1\u5E74\u6765\u8425\u8FD0\u7ECF\u8D39\u6301\u7EED\u77ED\u7F3A\uFF0C\u52A0\u4E0A\u9662\u820D\u7EF4\u62A4\u53CA\u513F\u7AE5\u7167\u62A4\u652F\u51FA\u4E0D\u65AD\u589E\u52A0\uFF0C\u672C\u9662\u76EE\u524D\u5DF2\u9762\u4E34\u4E25\u91CD\u7684\u8D22\u653F\u56F0\u96BE\u3002\u7ECF\u591A\u65B9\u8BC4\u4F30\u540E\uFF0C\u5E0C\u671B\u5B64\u513F\u9662\u9884\u8BA1\u5C06\u4E8E\u8FD1\u671F\u505C\u6B62\u8425\u8FD0\u3002\n\n\n\n\u76EE\u524D\uFF0C\u672C\u9662\u6B63\u79EF\u6781\u4E0E\u76F8\u5173\u653F\u5E9C\u5355\u4F4D\u53CA\u513F\u7AE5\u798F\u5229\u673A\u6784\u8054\u7CFB\uFF0C\u59A5\u5584\u5B89\u6392\u9662\u5185\u5B69\u5B50\u4EEC\u540E\u7EED\u7684\u751F\u6D3B\u4E0E\u5B89\u7F6E\u4E8B\u5B9C\uFF0C\u5E0C\u671B\u5C3D\u53EF\u80FD\u964D\u4F4E\u6B64\u6B21\u4E8B\u4EF6\u5BF9\u5B69\u5B50\u4EEC\u9020\u6210\u7684\u5F71\u54CD\u3002\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662
      \u656C\u542F\n\n---\n\n# \u5BB6\n\n\n\n---\n\n# \u4E66\u67B6\n\n\n\n\u4E66\u67B6\u4E0A\u6574\u9F50\u7684\u6446\u7740\u5404\u5F0F\u5404\u6837\u7684\u4E66\u7C4D\u3002\n\n\u300A\u4FA6\u63A2\u7684\u81EA\u6211\u4FEE\u517B\u300B\u3001\u300A\u903B\u8F91\u5047\u60F3\u8BAD\u7EC3\u300B\u3001\u300A\u8BB0\u5FC6\u5BAB\u6BBF\u6CD5\u300B\u7B49\u7B49\u6709\u52A9\u4E0E\u672C\u804C\u7684\u4E66\u7C4D\u3002\n\n\u9664\u6B64\u4E4B\u5916\u8FD8\u6709\u4E00\u4E9B\u5174\u8DA3\u4F7F\u7136\u800C\u6536\u96C6\u7684\u5C0F\u8BF4\u3001\u6F2B\u753B\u4E0E\u6742\u5FD7\u7B49\u3002\n\n---\n\n#
      \u7535\u8111\n\n\n\n\u53EF\u7528\u4E8E\u4E0A\u7F51\u67E5\u8BE2\u8D44\u6599\u6216\u6D4F\u89C8\u5404\u79CD\u7F51\u7AD9\u6216\u793E\u4EA4\u5A92\u4F53\u3002\n\n---\n\n#
      \u7EBF\u7D22\u677F\n\n\n\n\u5728\u8FD9\u91CC\u6574\u7406\u6240\u6709\u76F8\u5173\u7684\u7EBF\u7D22\u5E76\u63A8\u7406\u51FA\u771F\u76F8\u3002\n\n---\n\n#
      \u6025\u6551\u7BB1\n\n\n\n\u5728\u4E66\u67B6\u5E95\u5C42\u6709\u4E00\u4E2A\u5C0F\u578B\u7684\u6025\u6551\u7BB1\uFF0C\u4E0A\u9762\u6709\u4E2A\u84DD\u8272\u8774\u8776\u7684\u6807\u5FD7\u3002\n\n\u662F\u4F60\u5728\u5F00\u59CB\u72EC\u5C45\u540E\u4EE5\u9632\u4E07\u4E00\u4E70\u7684\uFF0C\u4E0D\u8FC7\u5E86\u5E78\u7684\u662F\u4F60\u7684\u8EAB\u4F53\u5F88\u5065\u5EB7\uFF0C\u5230\u73B0\u5728\u8FD8\u6CA1\u6709\u8FD9\u4E2A\u6025\u6551\u7BB1\u51FA\u5DEE\u7684\u673A\u4F1A\u3002\n\n---\n\n#
      \u793E\u4EA4\u5E73\u53F0\n\n\n\n---\n\n\u5728\u5931\u706B\u540E\u627E\u4E0D\u5230\u4EBA\uFF1F\u611F\u89C9\u9662\u957F\u6709\u70B9\u9ED1\u554A\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u679C\u7136\u662F\u8DD1\u8DEF\u4E86\u5417\u300D\n\n\u7559\u8A002\uFF1A\u300C\u771F\u7684\uFF0C\u4E0D\u53EF\u80FD\u8FD9\u4E48\u521A\u597D\u5427\u300D\n\n\u7559\u8A003\uFF1A\u300C\u65B0\u95FB\u76EE\u524D\u4E5F\u53EA\u8BF4\u5931\u8E2A\uFF0C\u8FD9\u4E48\u5FEB\u4E0B\u7ED3\u8BBA\u4E0D\u597D\u5427\u300D\n\n\n\n---\n\n\u5927\u534A\u591C\u7684\u600E\u4E48\u4F1A\u7A81\u7136\u610F\u5916\u7740\u706B\u5462\uFF1F\u771F\u7684\u5E78\u597D\u6709\u4EBA\u8D77\u5E8A\u53D1\u73B0\u4E86\u3002\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u771F\u7684\u662F\u610F\u5916\u5417\uFF1F\u300D\n\n\u7559\u8A002\uFF1A\u300C\u53EF\u80FD\u662F\u5EFA\u7B51\u6BD4\u8F83\u8001\u4E86\uFF0C\u54EA\u91CC\u7684\u7535\u8DEF\u6709\u95EE\u9898\u5427\u300D\n\n\u7559\u8A003\uFF1A\u300C\u53EF\u90A3\u5B64\u513F\u9662\u5F88\u50CF\u7EF4\u62A4\u7684\u5F88\u597D\u554A\uFF0C\u4F3C\u4E4E\u8FD8\u62FF\u8FC7\u4EC0\u4E48\u7F8E\u5316\u5956\u300D\n\n\u7559\u8A004\uFF1A\u300C\u4E0D\u7BA1\u600E\u6837\uFF0C\u5E78\u597D\u5B69\u5B50\u90FD\u6CA1\u4E8B\u300D\n\n\n\n---\n\n\u5C31\u53EA\u6709\u6211\u5728\u62C5\u5FC3\u90A3\u4E9B\u5B69\u5B50\u6CA1\u4E4B\u540E\u600E\u4E48\u529E\u5417\uFF1F\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u5E94\u8BE5\u4F1A\u88AB\u9001\u53BB\u54EA\u4E2A\u4E34\u65F6\u5B89\u7F6E\u4E2D\u5FC3\u5427\u300D\n\n\u7559\u8A002\uFF1A\u300C\u6211\u4EEC\u534F\u4F1A\u521A\u521A\u6536\u5230\u6D88\u606F\uFF0C\u5E94\u8BE5\u5C31\u662F\u90A3\u8FB9\u4E86\u300D\n\n\u7559\u8A003\uFF1A\u300C\u5E0C\u671B\u5B69\u5B50\u4EEC\u4E0D\u8981\u5413\u5230\u5C31\u597D\u300D\n\n\u7559\u8A004\uFF1A\u300C\u5458\u5DE5\u4EEC\u5E94\u8BE5\u4F1A\u4E00\u8D77\u8FC7\u53BB\u966A\u4ED6\u4EEC\u5427\u300D\n\n\n\n---\n\nXX\u6D88\u9632\u5C40\u63D0\u9192\u60A8\uFF0C\u9047\u5230\u706B\u707E\u65F6\u8BF7\uFF1A\n\n1.
      \u82E5\u60C5\u51B5\u5141\u8BB8\uFF0C\u8BF7\u5927\u58F0\u547C\u558A\uFF0C\u901A\u77E5\u9644\u8FD1\u7684\u5176\u4ED6\u4EBA\n2.
      \u5C06\u6BDB\u5DFE\u5F04\u6E7F\uFF0C\u76D6\u4F4F\u53E3\u9F3B\u5E76\u5E95\u4E0B\u8EAB\u5B50\u524D\u8FDB\n3.
      \u8BF7\u7ACB\u523B\u79BB\u5F00\u706B\u707E\u73B0\u573A\uFF0C\u5207\u52FF\u8D2A\u604B\u8D22\u7269\n4.
      \u5207\u52FF\u642D\u4E58\u7535\u68AF\uFF0C\u800C\u4EE5\u697C\u68AF\u9003\u751F\n\n\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u611F\u8C22\u63D0\u9192\uFF0C\u5DF2\u8F6C\u53D1\u300D\n\n\u7559\u8A002\uFF1A\u300C\u5E0C\u671B\u5927\u5BB6\u4E00\u8F88\u5B50\u90FD\u4E0D\u4F1A\u7528\u4E0A\u8FD9\u4E9B\u77E5\u8BC6\u300D\n\n\u7559\u8A003\uFF1A\u300C\u662F\u4E0D\u662F\u8981\u5728\u5BB6\u91CC\u81EA\u5907\u706D\u706B\u5668\u6BD4\u8F83\u597D\u554A\u300D\n\n\n\n---\n\n\u6628\u5929\u6DF1\u591C\u770B\u5230\u4E00\u8F86\u8D85\u9ED1\u7684\u8F66\uFF0C\u8FDE\u8F66\u73BB\u7483\u90FD\u548C\u6211\u5BB6\u90A3\u53EA\u9ED1\u732B\u4E00\u6837\u9ED1\u3002\n\n\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u5927\u534A\u591C\u7684\u4E0D\u662F\u770B\u4EC0\u4E48\u90FD\u662F\u9ED1\u7684\u5417\uFF1F\u300D\n\n\u7559\u8A002\uFF1A\u300C\u6CA1\u62CD\u4E0B\u6765\u5417\uFF0C\u8FD9\u79CD\u8FDD\u6CD5\u4EA4\u901A\u7684\u53EF\u4EE5\u62FF\u53BB\u4E3E\u62A5\u4E86\u300D\n\n\n\n---\n\n\u6211\u8BB0\u5F97\u6211\u5728\u54EA\u770B\u5230\u8BF4\u90A3\u95F4\u5B64\u513F\u9662\u672C\u6765\u5C31\u9884\u8BA1\u8981\u505C\u4E1A\u4E86\uFF0C\u90A3\u9662\u957F\u4E00\u5B9A\u662F\u4E0D\u60F3\u5904\u7406\u540E\u7EED\uFF0C\u6240\u4EE5\u76F4\u63A5\u653E\u706B\u70E7\u4E86\u5427\u3002\n\n\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u4E0D\u662F\u8BF4\u5F88\u8D5A\u94B1\u5417\uFF0C\u600E\u4E48\u4F1A\u505C\u4E1A\uFF1F\u300D\n\n\u7559\u8A002\uFF1A\u300C\u662F\u5417\uFF1F\u8DDF\u6211\u542C\u8BF4\u7684\u597D\u50CF\u6709\u70B9\u4E0D\u4E00\u6837\u300D\n\n\u7559\u8A003\uFF1A\u300C\u4E0D\u7BA1\u600E\u6837\uFF0C\u611F\u89C9\u8D8A\u6765\u8D8A\u53EF\u7591\u4E86\u554A\u300D\n\n\n\n---\n\n\u60F3\u7740\u53BB\u90A3\u95F4\u51FA\u4E8B\u7684\u5B64\u513F\u9662\u51D1\u51D1\u70ED\u95F9\uFF0C\u7ED3\u679C\u76F8\u673A\u653E\u5927\u62CD\u5230\u4E86\u8FD9\u5F20\u56FE\u3002\u8FD8\u771F\u6709\u4EBA\u4F1A\u5C06\u5BC6\u7801\u8BBE\u8BA1\u4E3A\u751F\u65E5\u65E5\u671F\u554A\u54C8\u54C8\u54C8\u54C8\u3002\n\n\n\n\u3010\u900F\u8FC7\u7A97\u53E3\u62CD\u5230\u5B64\u513F\u9662\u804C\u5458\u5BA4\u7684\u5176\u4E2D\u4E00\u53F0\u7535\u8111\uFF0C\u8367\u5E55\u8FB9\u7F18\u5E16\u7740\u7B14\u8BB0\u5199\u7740\u5BC6\u7801\u662F\u751F\u65E5\u3011\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u6211\u4E5F\u4F1A\u8FD9\u6837\uFF0C\u5BC6\u7801\u5C31\u771F\u7684\u5F88\u96BE\u8BB0\u554A\u300D\n\n\u7559\u8A002\uFF1A\u300C\u5B89\u5168\u610F\u8BC6\u6709\u5F85\u63D0\u9AD8\u554A\u300D\n\n\n\n---\n\n\u55B5\u55B5\uFF1A3\n\n\n\n\u7B80\u4ECB\n\n\u4E00\u4F4D\u4E49\u5DE5\n\n\n\n\u4E00\u4E9B\u5E16\u5B50\n\n\u597D\u5FC3\u798F\u5229\u9662\u7684\u7167\u7247\n\n\u4E00\u4E9B\u5E16\u5B50\n\n\n\n\n\n\uFF08\u5982\u679C\u8DD1\u4F4D\u4E86\uFF0Ccrtl
      + 0 \u56DE\u4E2D\u592E\uFF09\n\n\n\n---\n\n# \u5E0C\u671B\u5B64\u513F\u9662\u5B98\u65B9\u7F51\u7AD9\n\n\"\u5E0C\u671B\u5B64\u513F\u9662\"
      \"\u5E0C\u671B\u5B64\u513F\u9662\u5B98\u7F51\"\n\n\n\n\n\n## \u516C\u544A\uFF1A\u5173\u4E8E\u6682\u505C\u53D7\u7406\u513F\u7AE5\u9886\u517B\u7533\u8BF7\u7684\u516C\u544A\n\n\n\n\n\n##
      \u6D3B\u52A8\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\u5C0F\u578B\u8FD0\u52A8\u4F1A\n\n\n\n\n\n##
      \u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u6301\u7EED\u8425\u8FD0\u8BF4\u660E\n\n\n\n\n\n##
      \u516C\u544A\uFF1A\u5173\u4E8E\u5E0C\u671B\u5B64\u513F\u9662\u505C\u8FD0\u8BF4\u660E\n\n\n\n---\n\n##
      \u516C\u544A\uFF1A\u5173\u4E8E\u6682\u505C\u53D7\u7406\u513F\u7AE5\u9886\u517B\u7533\u8BF7\u7684\u516C\u544A\n\n\u53D1\u5E03\u65E5\u671F\uFF1A2012\u5E747\u670819\u65E5\n\n\n\n\u4E3A\u4E86\u8FDB\u4E00\u6B65\u5B8C\u5584\u672C\u9662\u513F\u7AE5\u7167\u62A4\u5236\u5EA6\uFF0C\u5E76\u914D\u5408\u9662\u5185\u8FD1\u671F\u8FDB\u884C\u7684\u9886\u517B\u6D41\u7A0B\u68C0\u89C6\u53CA\u76F8\u5173\u8D44\u6599\u6574\u7406\u5DE5\u4F5C\uFF0C\u81EA\u5373\u65E5\u8D77\uFF0C\u672C\u9662\u5C06\u6682\u505C\u53D7\u7406\u65B0\u7684\u513F\u7AE5\u9886\u517B\u7533\u8BF7\u3002\u6062\u590D\u53D7\u7406\u65F6\u95F4\u5C06\u89C6\u9662\u5185\u4F5C\u4E1A\u8FDB\u5EA6\u53E6\u884C\u516C\u544A\uFF0C\u9020\u6210\u60A8\u7684\u4E0D\u4FBF\uFF0C\u656C\u8BF7\u89C1\u8C05\u3002\n\n\n\n\u611F\u8C22\u5927\u5BB6\u4E00\u76F4\u4EE5\u6765\u7ED9\u4E88\u5B69\u5B50\u4EEC\u7684\u5173\u6000\u4E0E\u652F\u6301\uFF0C\u4E5F\u5E0C\u671B\u5927\u5BB6\u80FD\u591F\u7EE7\u7EED\u966A\u4F34\u5B69\u5B50\u4EEC\u5065\u5EB7\u6210\u957F\u3002\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662
      \u656C\u542F\n\n---\n\n## \u6D3B\u52A8\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\u5C0F\u578B\u8FD0\u52A8\u4F1A\n\n\u53D1\u5E03\u65E5\u671F\uFF1A2012\u5E747\u670813\u65E5\n\n\n\n\u672C\u5B64\u513F\u9662\u5C06\u4E0E\u5373\u5C06\u5230\u6765\u76848\u67081\u65E5\u4E3E\u529E\u4E00\u5E74\u4E00\u5EA6\u7684\u4E00\u4E2A\u5C0F\u578B\u8FD0\u52A8\u4F1A\u3002\n\n\n\n\u5C4A\u65F6\uFF0C\u5B69\u5B50\u4EEC\u5C06\u4F1A\u53C2\u4E0E\u5404\u5F0F\u5404\u6837\u8DA3\u5473\u5341\u8DB3\u7684\u7ADE\u8D5B\u9879\u76EE\uFF0C\u5728\u6B22\u7B11\u4E0E\u6311\u6218\u4E2D\u8D62\u53D6\u5956\u54C1\u4E0E\u7559\u4E0B\u7F8E\u597D\u7684\u56DE\u5FC6\u3002\n\n\n\n\u6D3B\u52A8\u5F53\u5929\uFF0C\u672C\u9662\u5C06\u5F00\u653E\u53C2\u89C2\uFF0C\u8BDA\u631A\u9080\u8BF7\u5404\u4F4D\u849E\u4E34\u73B0\u573A\uFF0C\u4E3A\u5B69\u5B50\u4EEC\u52A0\u6CB9\u6253\u6C14\uFF0C\u4E0E\u4ED6\u4EEC\u4E00\u540C\u5EA6\u8FC7\u4E00\u4E2A\u70ED\u95F9\u4E14\u6B22\u4E50\u7684\u65F6\u95F4\u3002\n\n\n\n\u6D3B\u52A8\u65E5\u671F\uFF1A2012\u5E748\u67081\u65E5\n\n\u6D3B\u52A8\u65F6\u95F4\uFF1A9\uFF1A00
      a.m. - 1\uFF1A00 p.m.\n\n\u6D3B\u52A8\u5730\u70B9\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\n\n---\n\n#
      \u5E0C\u671B\u5B64\u513F\u9662\n\n\"\u5730\u70B9\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\"\n\n\n\n\u4F60\u8FDC\u8FDC\u7684\u770B\u5230\u4E86\u5B64\u513F\u9662\u7684\u4E00\u4E2A\u90E8\u5206\u88AB\u70E7\u5F97\u7126\u9ED1\u3002\u76F8\u5173\u4EBA\u5458\u62C9\u4E86\u4E00\u6761\u300C\u7981\u6B62\u65E0\u5173\u4EBA\u58EB\u9760\u8FD1\u300D\u7684\u8B66\u6212\u6761\uFF0C\u8FDB\u884C\u7740\u4FEE\u590D\u5DE5\u4F5C\u6216\u540E\u7EED\u8C03\u67E5\u3002\u9664\u6B64\u4E4B\u5916\uFF0C\u9644\u8FD1\u8FD8\u96F6\u96F6\u6563\u6563\u7684\u56F4\u4E86\u4E00\u4E9B\u5C45\u6C11\u3002\n\n\u4F60\u53EF\u4EE5\u5728\u7A0D\u8FDC\u7684\u4F4D\u7F6E\u89C2\u5BDF\u5B64\u513F\u9662\u6216\u5411\u73B0\u573A\u4EBA\u5458\u53D6\u5F97\u8BB8\u53EF\u8FDB\u5B64\u513F\u9662\u8C03\u67E5\u3002\u4E5F\u53EF\u4EE5\u5411\u9644\u8FD1\u7684\u5C45\u6C11\u4EEC\u6253\u542C\u60C5\u62A5\u3002\n\n\n\n##
      \u89C2\u5BDF\u5B64\u513F\u9662\u60C5\u62A5\n\n\u4F3C\u4E4E\u662F\u706B\u52BF\u88AB\u53CA\u65F6\u63A7\u5236\u4E0B\u6765\uFF0C\u5927\u6982\u53EA\u6709\u56DB\u5206\u4E4B\u4E00\u7684\u90E8\u5206\u88AB\u70E7\u5F97\u7126\u9ED1\u3002~~\u5982\u679C\u5B64\u513F\u9662\u7684\u5E03\u5C40\u8FD8\u548C\u4F60\u8BB0\u5FC6\u91CC\u7684\u4E00\u6837\uFF0C\u88AB\u70E7\u6BC1\u7684\u533A\u57DF\u4F3C\u4E4E\u6709\u9662\u957F\u5BA4\u5728\u7684\u90E8\u5206\u3002~~\n\n\n\n##
      \u5B64\u513F\u9662\u5185\u7684\u60C5\u62A5\n\n### \u5165\u53E3\u5904\u9644\u8FD1\n\n\u5411\u9644\u8FD1\u7684\u8B66\u5458\u51FA\u793A\u4FA6\u63A2\u8BC1\u4EF6\u5E76\u53D6\u5F97\u8BB8\u53EF\u540E\uFF0C\u4F60\u8FDB\u5165\u5B64\u513F\u9662\u5185\u8C03\u67E5\u3002\u5165\u53E3\u5904\u9644\u8FD1\u7684\u89D2\u843D\u653E\u7740\u4E00\u4E9B\u8FD0\u52A8\u7528\u54C1\uFF0C\u6709\u547C\u5566\u5708\u3001\u513F\u7AE5\u6C99\u5305\u3001\u8DF3\u7EF3\u3001\u4E94\u989C\u516D\u8272\u7684\u5851\u6599\u7403\u7B49\uFF0C\u4F3C\u4E4E\u539F\u672C\u662F\u51C6\u5907\u5728\u4ECA\u5929\u7684\u8FD0\u52A8\u4F1A\u4E0A\u4F7F\u7528\u7684\u3002\u5F80\u804C\u5458\u5BA4\u8D70\u53BB\u7684\u8D70\u5ECA\u5899\u4E0A\u6709\u4E00\u4E2A\u5E03\u544A\u680F\uFF0C\u8D34\u7740\u5B69\u5B50\u4EEC\u7684\u4F5C\u54C1\u3001\u4E00\u4E9B\u65E5\u5E38\u901A\u77E5\u548C\u5E0C\u671B\u5B64\u513F\u9662\u7684\u804C\u5458\u7ED3\u6784\u56FE\u3002\n\n####
      \u804C\u5458\u7ED3\u6784\u56FE\n\n\u5305\u542B\u5E0C\u671B\u5B64\u513F\u9662\u91CC\u5168\u804C\u5458\u7684\u804C\u4F4D\u4E0E\u7167\u7247\u3002\n\n\u9662\u957F\uFF1A\u9648\u5FD7\u5B8F\n\n\u8D22\u653F\u804C\u5458\uFF1A\u9EC4\u56FD\u826F\n\n\u6559\u80B2\u804C\u5458\uFF1A\u738B\u79C0\u4E3D\n\n\u751F\u6D3B\u7167\u987E\u8D1F\u8D23\u4EBA\uFF1A\u5F20\u6167\u73B2
      \uFF08\u672C\u6848\u4EF6\u59D4\u6258\u4EBA\uFF09\n\n\u751F\u6D3B\u804C\u5458\uFF1A\u6797\u7F8E\u534E\uFF0C\u674E\u79C0\u82B3\uFF0C\u5218\u5FD7\u660E\n\n![](flowam:img-1787584472765-9g6phi
      =707x363)\n\n\n\n### \u804C\u5458\u5BA4\n\n\u804C\u5458\u5BA4\u662F\u4E00\u95F4\u5C0F\u578B\u7684\u529E\u516C\u5BA4\u3002\u9664\u4E86\u9662\u957F\uFF0C\u6BCF\u4E00\u4F4D\u804C\u5458\u90FD\u6709\u5C5E\u4E8E\u81EA\u5DF1\u7684\u529E\u516C\u7A7A\u95F4\uFF0C\u5404\u81EA\u7684\u684C\u4E0A\u4E5F\u90FD\u7C98\u7740\u8BE5\u804C\u5458\u7684\u540D\u5B57\u3002\u5F20\u6167\u73B2\u7684\u684C\u4E0A\u653E\u7740\u5173\u4E8E\u8FD9\u6B21\u8FD0\u52A8\u4F1A\u7684\u6D41\u7A0B\u8868\u3002\u738B\u79C0\u4E3D\u7684\u684C\u4E0A\u653E\u7740\u6279\u6539\u5230\u4E00\u534A\u7684\u5B69\u5B50\u4EEC\u7684\u4F5C\u4E1A\u3002\u674E\u79C0\u82B3\u7684\u7535\u8111\u8367\u5E55\u8FB9\u7F18\u7C98\u7740\u4E00\u5F20\u63D0\u9192\u81EA\u5DF1\u5BC6\u7801\u7684\u5C0F\u7EB8\u6761\u3002\n\n\n\n##
      \u5411\u5C45\u6C11\u6253\u542C\u83B7\u5F97\u7684\u60C5\u62A5\n\n\u300C\u51CC\u6668\u7A81\u7136\u542C\u5230\u8B66\u62A5\u58F0\u4E0E\u5176\u4ED6\u4EBA\u7684\u558A\u53EB\u58F0\uFF0C\u51FA\u53BB\u770B\u7684\u65F6\u5019\u706B\u707E\u5DF2\u7ECF\u86EE\u5927\u7684\u4E86\u3002\u300D\n\n\u300C\u4E0D\u8FC7\u5E78\u597D\u90A3\u65F6\u5019\u804C\u5458\u4EEC\u5DF2\u7ECF\u5B89\u5168\u628A\u5168\u90E8\u5B69\u5B50\u5E26\u51FA\u6765\u4E86\u3002\u300D\n\n\u300C\u6700\u8FD1\u5927\u534A\u591C\u7684\u90FD\u8FD8\u80FD\u770B\u5230\u5B64\u513F\u9662\u91CC\u8FD8\u6709\u623F\u95F4\u4EAE\u7740\u706F\uFF0C\u4F3C\u4E4E\u5C31\u662F\u88AB\u70E7\u4E86\u7684\u90A3\u4E2A\u623F\u95F4\u3002\u300D\n\n\u300C\u6700\u8FD1\u548C\u4E00\u4F4D\u804C\u5458\u804A\u5929\u7684\u65F6\u5019\uFF0C\u542C\u8BF4\u8FD9\u51E0\u4E2A\u6708\u6765\u9886\u517B\u5B69\u5B50\u7684\u4EBA\u53D8\u591A\u4E86\u3002\u300D\n\n\u300C\u5509\uFF0C\u96BE\u5F97\u5B69\u5B50\u4EEC\u4E00\u5E74\u4E00\u5EA6\u7684\u8FD0\u52A8\u4F1A\uFF0C\u5C31\u8FD9\u6837\u88AB\u6BC1\u4E86\uFF0C\u771F\u662F\u8FD0\u6C14\u4E0D\u597D\u554A\u3002\u300D\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u597D\u5FC3\u798F\u5229\u9662\n\n\"\u5730\u70B9\uFF1A\u597D\u5FC3\u798F\u5229\u9662\"\n\n\n\n\u4F60\u6765\u5230\u597D\u5FC3\u798F\u5229\u9662\uFF0C\u4E49\u5DE5\u4EEC\u6B63\u5E2E\u5FD9\u5B89\u7F6E\u88AB\u8F6C\u79FB\u8FC7\u6765\u7684\u5B69\u5B50\u3002\n\n\n\n##
      \u5411\u4E49\u5DE5\u6253\u542C\u60C5\u62A5\n\n\u4E49\u5DE5A\u300C\u6211\u4EEC\u793E\u56E2\u770B\u5230\u706B\u707E\u53D1\u751F\u540E\uFF0C\u5C31\u7B2C\u4E00\u65F6\u95F4\u8054\u7EDC\u4E86\u90A3\u8FB9\u7684\u804C\u5458\u4EEC\uFF0C\u8BF4\u6211\u4EEC\u8FD9\u53EF\u4EE5\u4E3A\u5B69\u5B50\u4EEC\u63D0\u4F9B\u4E00\u4E2A\u4E34\u65F6\u7684\u907F\u96BE\u6240\u3002\u300D\n\n\u4E49\u5DE5B\u300C\u6709\u4E00\u4E9B\u5B69\u5B50\u4F3C\u4E4E\u88AB\u5413\u5230\u4E86\uFF0C\u6211\u4EEC\u6B63\u51C6\u5907\u7740\u4E00\u4E9B\u5C0F\u6E38\u620F\u6253\u7B97\u7B49\u7B49\u4E0E\u5B69\u5B50\u4EEC\u4E00\u8D77\u73A9\u3002\u6709\u5174\u8DA3\u7684\u8BDD\u4F60\u4E5F\u4E00\u8D77\u628A\u3002\u300D\n\n\n\n##
      \u5411\u5B69\u5B50\u4EEC\u6253\u542C\u60C5\u62A5\n\n\u6216\u8BB8\u56E0\u4E3A\u610F\u5916\u7684\u53D1\u751F\u4E0E\u8EAB\u5904\u4E0D\u719F\u6089\u7684\u73AF\u5883\uFF0C\u5B69\u5B50\u4EEC\u663E\u5F97\u6709\u4E9B\u7D27\u5F20\u3002\u60F3\u8981\u4ECE\u5B69\u5B50\u4EEC\u54EA\u91CC\u95EE\u51FA\u70B9\u4EC0\u4E48\u4F3C\u4E4E\u5F97\u5148\u5B89\u629A\u4ED6\u4EEC\u7684\u60C5\u7EEA\u3002\n\n\u3010\u4E0E\u5B69\u5B50\u4EEC\u73A9\u5C0F\u6E38\u620F\u540E\u83B7\u53D6\u60C5\u62A5\u3011\n\n\n\n\u5B69\u5B50A\u300C\u9662\u957F\u8001\u5E08\u53BB\u54EA\u91CC\u4E86\uFF0C\u8FD8\u80FD\u770B\u5230\u4ED6\u5417\u2026\u2026\u300D\n\n\u5B69\u5B50B\u300C\u4E4B\u524D\u548C\u9662\u957F\u8001\u5E08\u8D8A\u597D\u4E86\u8981\u4E00\u8D77\u53BB\u516C\u56ED\u6316\u5B9D\u85CF\u7684\u300D\n\n\u5B69\u5B50C\u300C\u55EF\uFF1F\u6211\u5728\u753B\u8774\u8776\u5440~\u4E4B\u524D\u770B\u5230\u5218\u8001\u5E08\u62FF\u7740\u7684\u4E00\u5F20\u5361\u7247\u4E0A\u6709\u4E00\u4E2A\u5F88\u6F02\u4EAE\u7684\u84DD\u8272\u8774\u8776\uFF0C\u6211\u60F3\u628A\u5B83\u753B\u51FA\u6765\uFF01\u300D\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u65B0\u95FB\u5E73\u53F0\n\n\n\n---\n\n## \u65B0\u95FB\uFF1ABB-04\uFF0C\u6253\u7834\u533B\u5B66\u754C\u96BE\u9898\uFF0C\u6839\u6CBB\u7EDD\u75C7\uFF01\n\n\u53D1\u5E03\u65E5\u671F\uFF1A2012\u5E746\u670829\u65E5\n\n\n\n\u84DD\u8776\u5236\u836F\u516C\u53F8\u4E8E\u4ECA\u65E5\u53D1\u5E03\u4E86\u4ED6\u4EEC\u6700\u65B0\u7684\u7814\u53D1\u6210\u679C\u201CBB-04\u201D\u3002\u8BE5\u836F\u7269\u5C06\u6709\u671B\u6839\u6CBB\u56F0\u6270\u4E86\u533B\u5B66\u754C\u7684\u8BB8\u4E45\u7684\u764C\u75C7\u3001\u827E\u6ECB\u75C5\u7B49\u7EDD\u75C7\u3002\n\n\n\n\u636E\u8BE5\u9879\u76EE\u8D1F\u8D23\u4EBA\u6240\u8BF4\uFF0C\u8BE5\u836F\u7269\u76EE\u524D\u8FD8\u5904\u4E8E\u5B9E\u9A8C\u9636\u6BB5\uFF0C\u4F46\u76F8\u4FE1\u5728\u4E0D\u4E45\u7684\u5C06\u6765BB-04\u5C06\u6B63\u5F0F\u6210\u4E3A\u533B\u5B66\u754C\u7684\u5947\u8FF9\u3002\n\n\n\n\n\n\u3010\u9644\u4E0A\u9879\u76EE\u8D1F\u8D23\u4EBA\u4E8E\u53D1\u8868\u4F1A\u6F14\u8BB2\u65F6\u7684\u7167\u7247\u3011\n\n\u4ED4\u7EC6\u5BF9\u6BD4\u540E\u5C31\u4F1A\u53D1\u73B0\u5728\u53F0\u4E0A\u6F14\u8BB2\u7684\u8D1F\u8D23\u4EBA\u5C31\u662F\u5E0C\u671B\u5B64\u513F\u9662\u7684\u5176\u4E2D\u4E00\u4F4D\u804C\u5458\u5218\u5FD7\u660E\n\n---\n\n#
      \u65B0\u95FB\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\uFF0C\u9662\u957F\u4E0B\u843D\u4E0D\u660E\uFF01\n\n\n\n\u4ECA\u65E5\uFF088\u67081\u65E5\uFF09\u63A5\u8FD1\u6E05\u6668\u65F6\u5206\uFF0C\u4F4D\u4E8E\u90CA\u5916\u7684\u5E0C\u671B\u5B64\u513F\u9662\u7A81\u53D1\u706B\u707E\u3002\u6240\u5E78\u4E8B\u53D1\u5F53\u65F6\u4EE5\u6709\u51E0\u540D\u5B64\u513F\u9662\u91CC\u7684\u804C\u5458\u8D77\u8EAB\uFF0C\u4ED6\u4EEC\u7B2C\u4E00\u65F6\u95F4\u53D1\u73B0\u4E8B\u6545\u5411\u6D88\u9632\u5C40\u62A5\u4E86\u6848\uFF0C\u5E76\u5408\u7406\u758F\u6563\u5728\u5B64\u513F\u9662\u91CC\u7684\u5B64\u513F\u4EEC\u3002\u6D88\u9632\u5458\u4E5F\u968F\u540E\u8D76\u5230\u5C06\u706B\u707E\u8303\u56F4\u9650\u5236\u5E76\u6251\u706D\u7531\u4E8E\u804C\u5458\u4EEC\u8FC5\u901F\u7684\u5224\u65AD\uFF0C\u672C\u8D77\u706B\u707E\u5E76\u65E0\u9020\u6210\u4EFB\u4F55\u4EBA\u5458\u7684\u4F24\u4EA1\u3002\n\n\n\n\u6B63\u5F53\u4E00\u5207\u770B\u4F3C\u6709\u60CA\u65E0\u9669\u7684\u7ED3\u675F\u65F6\uFF0C\u5374\u4F20\u51FA\u4E86\u5B64\u513F\u9662\u9662\u957F\uFF08\u9648\u5FD7\u5B8F\uFF09\u5931\u8E2A\u7684\u6D88\u606F\u3002\u636E\u51E0\u4F4D\u804C\u5458\u6240\u8BF4\uFF0C\u4ED6\u4EEC\u5728\u5C31\u5BDD\u4E4B\u524D\u8FD8\u6709\u89C1\u8FC7\u9662\u957F\uFF0C\u4F46\u5728\u706B\u707E\u53D1\u751F\u540E\u7684\u73B0\u5728\u5374\u4E0D\u89C1\u4ED6\u4EBA\uFF0C\u4E5F\u65E0\u6CD5\u4E0E\u4ED6\u53D6\u5F97\u8054\u7EDC\u3002\u6D88\u9632\u4EBA\u58EB\u4E5F\u6CA1\u6709\u5728\u706B\u707E\u73B0\u573A\u627E\u5230\u7591\u4F3C\u9662\u957F\u7684\u4EBA\u5F71\u3002\u6B64\u60C5\u51B5\u5DF2\u4E0A\u62A5\u8B66\u65B9\uFF0C\u5E76\u88AB\u5224\u65AD\u4E3A\u5931\u8E2A\u3002\n\n\n\n\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u5E78\u597D\u53CA\u65F6\u53D1\u73B0\u2026\u2026\u300D\n\n\u7559\u8A002\uFF1A\u300C\u6CA1\u8BF4\u4EC0\u4E48\u539F\u56E0\u53D1\u751F\u7684\u706B\u707E\u5417\uFF1F\u300D\n\n\u7559\u8A003\uFF1A\u300C\u9662\u957F\u5377\u6B3E\u8DD1\u8DEF\u4E86\u5427\u300D\n\n\u7559\u8A004\uFF1A\u300C\u771F\u7684\u5047\u7684\uFF1F\uFF01\u90A3\u8FD9\u706B\u4E0D\u4F1A\u4E5F\u662F\u9662\u957F\u653E\u7684\u5427\u300D\n\n\u7559\u8A005\uFF1A\u300C\u90A3\u8FD9\u7FA4\u5B64\u513F\u4E4B\u540E\u4F4F\u54EA\u554A\uFF1F\u300D\n\n\u7559\u8A006\uFF1A\u300C\u4E00\u4E2A\u5C0F\u5C0F\u7684\u5B64\u513F\u9662\u5374\u80FD\u591F\u7ECF\u8425\u8FD9\u4E48\u4E45\uFF0C\u516B\u6210\u662F\u6709\u5728\u80CC\u540E\u5E72\u4E9B\u4E0D\u5E72\u51C0\u7684\u52FE\u5F53\u5427\u3002\u300D\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u65B0\u95FB\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\u706B\u707E\u4E0E\u9662\u957F\u5931\u8E2A\u3002\u4E8B\u53D1\u524D\u4F3C\u4E4E\u6709\u53EF\u7591\u8FF9\u8C61\uFF1F\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662\u4ECA\u65E5\u51CC\u6668\u53D1\u751F\u706B\u707E\uFF0C\u6D88\u9632\u5C40\u63A5\u83B7\u62A5\u6848\u540E\u8FC5\u901F\u8D76\u5F80\u73B0\u573A\uFF0C\u6210\u529F\u63A7\u5236\u706B\u52BF\uFF0C\u6240\u5E78\u9662\u5185\u513F\u7AE5\u53CA\u804C\u5458\u5747\u5DF2\u53CA\u65F6\u758F\u6563\uFF0C\u5E76\u672A\u9020\u6210\u4EBA\u5458\u4F24\u4EA1\u3002\u672C\u62A5\u8BB0\u8005\u7B2C\u4E00\u65F6\u95F4\u8D70\u8BBF\u9644\u8FD1\u5C45\u6C11\u5E76\u5F97\u5230\u4E86\u4E00\u4E0B\u51E0\u70B9\u8BF4\u6CD5\u3002\n\n\n\n\u6709\u5C45\u6C11\u8868\u793A\uFF0C\u5B64\u513F\u9662\u7684\u8BBE\u5907\u4F3C\u4E4E\u4E00\u76F4\u90FD\u6709\u5728\u68C0\u70B9\u7FFB\u65B0\uFF0C\u5E94\u8BE5\u4E0D\u592A\u53EF\u80FD\u53D1\u751F\u610F\u5916\u3002\u4E5F\u6709\u5C45\u6C11\u8868\u793A\uFF0C\u8FD9\u4E00\u4E2A\u6708\u6765\u9648\u5FD7\u5B8F\u9662\u957F\u4F3C\u4E4E\u6BCF\u5929\u90FD\u65E9\u51FA\u665A\u5F52\uFF0C\u4E0D\u592A\u50CF\u4ED6\u4EE5\u524D\u7684\u4F5C\u98CE\u3002\u53E6\u4E00\u4F4D\u5C45\u6C11\u5219\u8868\u793A\uFF0C\u5F53\u665A\u66FE\u770B\u5230\u4E00\u8F86\u9ED1\u8272\u8F7F\u8F66\u505C\u9760\u5728\u5B64\u513F\u9662\u9644\u8FD1\u3002\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u8BC4\u8BBA\u533A\u5DF2\u5173\u95ED\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u65B0\u95FB\uFF1A\u5E0C\u671B\u5B64\u513F\u9662\u524D\u8EAB\u5C3D\u662F\uFF1F\uFF01\u8FD9\u573A\u5927\u706B\u6050\u6015\u65E9\u5DF2\u6CE8\u5B9A\u2026\u2026\n\n\n\n\u5E0C\u671B\u5B64\u513F\u9662\u6240\u5728\u7684\u4F4D\u7F6E\uFF0C\u5728\u6570\u5341\u5E74\u524D\u7591\u4F3C\u66FE\u662F\u4E00\u5904\u5893\u56ED\u3002\u672C\u62A5\u8BB0\u8005\u76F8\u7EE7\u91C7\u8BBF\u4E86\u51E0\u4F4D\u4E13\u4E1A\u98CE\u6C34\u5E08\uFF0C\u4ED6\u4EEC\u90FD\u7EB7\u7EB7\u8868\u793A\u706B\u707E\u7684\u53D1\u751F\u90FD\u662F\u5F53\u5730\u9634\u6C14\u805A\u96C6\u6240\u5BFC\u81F4\uFF0C\u751A\u81F3\u8FDE\u9662\u957F\u5931\u8E2A\u4E00\u4E8B\u4E5F\u53EF\u80FD\u4E0E\u6B64\u539F\u56E0\u6709\u5173\u2026\u2026\n\n\n\n\n\n\n\n##
      \u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u98CE\u6C34\u90FD\u6765\u4E86\u2026\u2026\u300D\n\n\u7559\u8A002\uFF1A\u300C\u6709\u4E9B\u4E1C\u897F\u4E0D\u80FD\u4E0D\u4FE1\u300D\n\n\u7559\u8A003\uFF1A\u300C\u4E13\u5BB6\u662F\u8C01\uFF1F\u8FDE\u540D\u5B57\u90FD\u6CA1\u6709\u300D\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u84DD\u8776\u5236\u836F\u516C\u53F8\u5B98\u65B9\u7F51\u7AD9\n\n\"\u84DD\u8272\u8774\u8776\"
      \"\u84DD\u8272 \u8774\u8776\"\n\n\n\n--\u63A2\u7A76\u79D1\u5B66\u7684\u5883\u754C\uFF0C\u613F\u5C06\u5947\u8FF9\u7684\u84DD\u8272\u8774\u8776\u5E26\u5230\u6BCF\u4E2A\u4EBA\u8EAB\u8FB9--\n\n\n\n\n\n##
      \u5173\u4E8E\u6700\u65B0\u836F\u7269 \u300CBB-04\u300D\u7684\u5BA3\u4F20\n\n\u5199\u4E86\u4E00\u4E9B\u8BE5\u836F\u7269\u7684\u529F\u6548\u4E0E\u5B83\u81F3\u4E8E\u76EE\u524D\u533B\u7597\u754C\u7684\u91CD\u8981\u7A81\u7834\u3002\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n#
      \u516C\u56ED\n\n\"\u5730\u70B9\uFF1A\u516C\u56ED\"\n\n\n\n\u5B64\u513F\u9662\u9644\u8FD1\u7684\u4E00\u4E2A\u5C0F\u578B\u516C\u56ED\uFF0C\u6E38\u5177\u7684\u79CD\u7C7B\u4E5F\u504F\u5C11\u3002\u53EF\u4EE5\u770B\u5230\u6709\u4E00\u4F4D\u5E74\u8FC8\u7684\u8001\u7237\u7237\u6B63\u5728\u5582\u9E3D\u5B50\u3002\n\n\n\n##
      \u5411\u8001\u7237\u7237\u6253\u542C\u60C5\u62A5\n\n\u300C\u6211\u5F88\u5E38\u6765\u8FD9\u4E2A\u516C\u56ED\u6563\u6B65\u5582\u5582\u9E3D\u5B50\u4EC0\u4E48\u7684\u3002\u9644\u8FD1\u5B64\u513F\u9662\u7684\u5B69\u5B50\u4EEC\u65F6\u4E0D\u65F6\u4E5F\u4F1A\u6765\u8FD9\u91CC\uFF0C\u6211\u4E5F\u4F1A\u8DDF\u4ED6\u4EEC\u73A9\u3002\u300D\n\n\u300C\u4ED6\u4EEC\u4E0A\u4E00\u6B21\u6765\u65F6\u8DDF\u6211\u8BF4\u4ECA\u5929\u6709\u4E2A\u8FD0\u52A8\u4F1A\uFF0C\u9080\u8BF7\u6211\u53BB\u53C2\u89C2\uFF0C\u6CA1\u60F3\u5230\u5C31\u53D1\u751F\u4E86\u8FD9\u79CD\u4E8B\u3002\u300D\n\n\u300C\u8BDD\u8BF4\u6709\u4E00\u6B21\u6211\u5076\u7136\u9047\u5230\u9648\u9662\u957F\uFF0C\u4ED6\u4EC0\u4E48\u4E5F\u6CA1\u8BF4\u5C31\u8BA9\u6211\u5E2E\u5FD9\u4FDD\u7BA1\u4E00\u628A\u94A5\u5319\uFF0C\u73B0\u5728\u4ED6\u51FA\u4E86\u8FD9\u79CD\u4E8B\u6211\u8BE5\u62FF\u8FD9\u94A5\u5319\u600E\u4E48\u529E\u5462\uFF1F\u300D\n\n\u300C\u8981\u4E0D\u8FD9\u94A5\u5319\u5148\u7ED9\u4F60\u5427\uFF0C\u6BD4\u8D77\u653E\u5728\u6211\u8FD9\uFF0C\u4F60\u6BD4\u8F83\u6709\u53EF\u80FD\u4ECE\u7528\u8FD9\u628A\u94A5\u5319\u8C03\u67E5\u51FA\u4E9B\u4EC0\u4E48\u3002\u300D\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n\n\u4FA6\u63A2\u8D44\u683C\u6D4B\u8BD5\u7EC3\u4E60\u9898\u300A\u5931\u8E2A\u7684\u732B\u300B\n\n---\n\n#
      \u8BC1\u4EBAC : \u8D75\u5148\u751F\n\n\n\n\u300C\u5927\u7EA6\u4E0B\u53483\uFF1A30\uFF0C\u6211\u548C\u6211\u5973\u513F\u521A\u597D\u8DEF\u8FC7\u516C\u56ED\u770B\u5230\u4E86\u5C0F\u6A58\u3002\u56E0\u4E3A\u5B83\u5DE6\u8FB9\u8033\u6735\u7684\u7F3A\u53E3\u6240\u4EE5\u6211\u5F88\u786E\u5B9A\u662F\u5C0F\u6A58\u6CA1\u9519\u3002\u6211\u8FD8\u7528\u6211\u624B\u673A\u62CD\u4E86\u5F20\u6211\u5973\u513F\u548C\u5C0F\u6A58\u7684\u7167\u7247\uFF0C\u8FD9\u5C31\u662F\u90A3\u65F6\u5019\u7684\u7167\u7247\u3002\u300D\n\n\n\n\u8D75\u5148\u751F\u5973\u513F\u4E0E\u5C0F\u6A58\u7684\u7167\u7247\n\n\u7167\u7247\u91CC\u80FD\u770B\u5230\u4E00\u540D\u5C0F\u5973\u5B69\u4F3C\u4E4E\u8E51\u624B\u8E51\u811A\u7684\u8981\u9760\u8FD1\u4E00\u53EA\u722C\u7740\u7684\u6A58\u732B\u3002\u7167\u7247\u91CC\u53EF\u4EE5\u5F88\u660E\u663E\u7684\u770B\u5230\u732B\u7684\u5DE6\u8033\u4E0A\u6709\u4E2A\u5C0F\u7F3A\u53E3\u3002\n\n\n\n---\n\n#

  tutorialClueDescription: "\u300C\u6211\u662F\u540D\u4FBF\u5229\u5E97\u5458\u5DE5\uFF0C\u90A3\u6BB5\u65F6\u95F4\u521A\u597D\u662F\u6211\u7684\u503C\u73ED\u65F6\u95F4\u3002\u5728\u5927\u7EA6\u4E0B\u53483\uFF1A15\u65F6\uFF0C\u6211\u770B\u5230\u4FBF\u5229\u5E97\u7684\u95E8\u53E3\u8D70\u8FC7\u53BB\u4E00\u53EA\u6A58\u732B\u3002\u6216\u8BB8\u6211\u53EF\u4EE5\u8C03\u4E00\u4E0B\u5E97\u5916\u7684\u76D1\u63A7\u770B\u770B\u662F\u4E0D\u662F\u5C0F\u6A58\u3002\u300D\n\n\u300C\u6709\u4E86\uFF0C\u8FD9\u662F\u90A3\u65F6\u5019\u62CD\u5230\u7684\u7167\u7247\u3002\u6211\u8BB0\u5F97\u5B83\u5F53\u65F6\u5F80\u516C\u56ED\u7684\u65B9\u5411\u8DD1\u53BB\u4E86\u3002\u300D\n\n\n\n\u4FBF\u5229\u5E97\u76D1\u63A7\u622A\u56FE\n\n\u753B\u9762\u4E2D\u6709\u4E00\u53EA\u5168\u8EAB\u6A58\u8272\u7684\u732B\u3002\u732B\u7684\u5DE6\u8033\u4E0A\u6709\u4E2A\u5C0F\u7F3A\u53E3\u3002"

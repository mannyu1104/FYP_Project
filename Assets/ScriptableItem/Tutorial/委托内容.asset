  TutorialClueDataTest: {fileID: 11400000, guid: e6aaaf253544a524d878a700c627ba63, type: 2}
  ItemShowName: "\u59D4\u6258\u5185\u5BB9"
  Description: "\u59D4\u6258\u4EBA\uFF1A\u5F20\u5973\u58EB  \u6211\u7684\u732B\u300C\u5C0F\u6A58\u300D\u4ECA\u5929\u4E0B\u5348\u4E0D\u89C1\u4E86\u3002 
    \u5C0F\u6A58\u5E73\u65F6\u867D\u7136\u4F1A\u5728\u9644\u8FD1\u6D3B\u52A8\uFF0C\u4F46\u901A\u5E38\u4E0D\u4F1A\u79BB\u5BB6\u592A\u8FDC\u3002 
    \u4ECA\u5929\u4E0B\u5348\uFF0C\u6211\u53D1\u73B0\u5B83\u6CA1\u6709\u50CF\u5F80\u5E38\u4E00\u6837\u56DE\u6765\u3002\u6211\u5BFB\u627E\u4E86\u4E00\u6BB5\u65F6\u95F4\u540E\uFF0C\u4ECD\u7136\u6CA1\u6709\u627E\u5230\u5B83\u3002 
    \u5E78\u8FD0\u7684\u662F\uFF0C\u6709\u4E94\u540D\u9644\u8FD1\u5C45\u6C11\u8868\u793A\u66FE\u7ECF\u89C1\u5230\u5C0F\u6A58\u3002 
    \u4F46\u4ED6\u4EEC\u63D0\u4F9B\u7684\u60C5\u62A5\u4F3C\u4E4E\u5E76\u4E0D\u5B8C\u5168\u4E00\u81F4\u3002 
    \u8BF7\u6839\u636E\u4EE5\u4E0B\u8D44\u6599\uFF0C\u5224\u65AD\u54EA\u4E9B\u8BC1\u4EBA\u7684\u8BC1\u8BCD\u53EF\u4FE1\u3002"

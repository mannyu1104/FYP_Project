  m_EditorClassIdentifier: Assembly-CSharp::NewsArticleData
  headline: "\u5E0C\u671B\u5B64\u513F\u9662\u524D\u8EAB\u5C3D\u662F\uFF1F\uFF01\u8FD9\u573A\u5927\u706B\u6050\u6015\u65E9\u5DF2\u6CE8\u5B9A\u2026\u2026"
  date: "2012\u5E748\u67081\u65E5"
  content: "\u5E0C\u671B\u5B64\u513F\u9662\u6240\u5728\u7684\u4F4D\u7F6E\uFF0C\u5728\u6570\u5341\u5E74\u524D\u7591\u4F3C\u66FE\u662F\u4E00\u5904\u5893\u56ED\u3002\u672C\u62A5\u8BB0\u8005\u76F8\u7EE7\u91C7\u8BBF\u4E86\u51E0\u4F4D\u4E13\u4E1A\u98CE\u6C34\u5E08\uFF0C\u4ED6\u4EEC\u90FD\u7EB7\u7EB7\u8868\u793A\u706B\u707E\u7684\u53D1\u751F\u90FD\u662F\u5F53\u5730\u9634\u6C14\u805A\u96C6\u6240\u5BFC\u81F4\uFF0C\u751A\u81F3\u8FDE\u9662\u957F\u5931\u8E2A\u4E00\u4E8B\u4E5F\u53EF\u80FD\u4E0E\u6B64\u539F\u56E0\u6709\u5173\u2026\u2026\n\n\n\n\n\n\n\n\u8BC4\u8BBA\u533A\n\n\u7559\u8A001\uFF1A\u300C\u98CE\u6C34\u90FD\u6765\u4E86\u2026\u2026\u300D\n\n\u7559\u8A002\uFF1A\u300C\u6709\u4E9B\u4E1C\u897F\u4E0D\u80FD\u4E0D\u4FE1\u300D\n\n\u7559\u8A003\uFF1A\u300C\u4E13\u5BB6\u662F\u8C01\uFF1F\u8FDE\u540D\u5B57\u90FD\u6CA1\u6709\u300D"
